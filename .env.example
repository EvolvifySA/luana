NUVEMVET_SENHA=sua_senha

# ─── URLs do NuvemVet ─────────────────────────────────────────
NUVEMVET_BASE_URL=https://sistema.nuvemvet.com
NUVEMVET_LOGIN_URL=https://www.nuvemvet.com/entrar

# ─── Pasta de dados exportados ────────────────────────────────
DATA_DIR=dados_exportados

# ─── Scraper ──────────────────────────────────────────────────
SCRAPER_DELAY=0.8
SCRAPER_LIMIT=500

# ─── Aplicação web (Evolvify) ─────────────────────────────────
